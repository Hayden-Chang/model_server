# Public endpoint
PUBLIC_DOMAIN=api.keeline.xyz

# Generate independent random values for the new service. Do not reuse provider keys.
BUSINESS_API_KEY=replace-with-at-least-32-random-characters
ADMIN_API_KEY=replace-with-at-least-32-random-characters
LITELLM_MASTER_KEY=replace-with-at-least-32-random-characters

# Signs stateless guest tokens for the Time Fragment iOS client. Keep this
# independent from the business and provider keys.
TIME_FRAGMENT_TOKEN_SECRET=replace-with-at-least-32-random-characters
TIME_FRAGMENT_TOKEN_TTL_SECONDS=2592000
TIME_FRAGMENT_GUEST_QUOTA_LIMIT=30
# Daily AI planning allowance for signed-in members, read by the account
# service only; not the base SQLite store's fixed 50/day development-member limit.
TIME_FRAGMENT_MEMBER_QUOTA_LIMIT=30

# Raw request/response content is removed after this many days. Token, timing,
# status, and device aggregates remain available.
USAGE_CONTENT_RETENTION_DAYS=30

# Any LiteLLM-supported provider can be configured here. For an OpenAI-compatible
# domestic provider, keep the openai/ prefix and set its API base URL.
LLM_MODEL=openai/your-provider-model-id
LLM_API_BASE=https://provider.example.com/v1
LLM_API_KEY=replace-with-provider-api-key

# Use json_schema when the provider supports strict JSON Schema output.
# Change to json_object for providers that only implement JSON mode; local schema
# validation in the post-processing layer remains enabled in either mode.
STRUCTURED_OUTPUT_MODE=json_schema

# Optional account API cutover (docker-compose.accounts.yml).
# Preserve TIME_FRAGMENT_TOKEN_SECRET so existing installation tokens stay valid.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-project-publishable-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
PLANNING_INTERNAL_SECRET=replace-with-independent-32-or-more-random-characters

# App Store Server API credentials, used by both time-fragment-api (the /billing
# routes) and billing-worker. The containers read the mounted key file, so
# APPLE_PRIVATE_KEY_PATH is the form production uses and its value must stay in
# step with the read-only ./.secrets mount in docker-compose.accounts.yml.
# APPLE_PRIVATE_KEY is only an inline fallback for a deployment with no file.
# The two ids are empty in the Compose defaults; billing keeps failing closed
# with BILLING_NOT_CONFIGURED (503) until the ids and a usable key are set.
APPLE_ENVIRONMENT=sandbox
APPLE_KEY_ID=
APPLE_ISSUER_ID=
APPLE_BUNDLE_ID=com.hayden.timefragment
APPLE_PRIVATE_KEY=
APPLE_PRIVATE_KEY_PATH=/opt/model_server/.secrets/apple.p8

# Required by the Compose file (${STORE_REFERENCE_KEY:?...}): an unset or empty
# value stops the account services from starting at all. Encrypts the stored
# original transaction id; rotate it independently of the API keys.
STORE_REFERENCE_KEY=replace-with-rotated-store-reference-key

# Seconds between billing-worker reconciliation passes.
BILLING_WORKER_INTERVAL_SECONDS=300
