# Public endpoint
PUBLIC_IP=47.120.13.5

# Generate independent random values for the new service. Do not reuse provider keys.
BUSINESS_API_KEY=replace-with-at-least-32-random-characters
LITELLM_MASTER_KEY=replace-with-at-least-32-random-characters

# Signs stateless guest tokens for the Time Fragment iOS client. Keep this
# independent from the business and provider keys.
TIME_FRAGMENT_TOKEN_SECRET=replace-with-at-least-32-random-characters
TIME_FRAGMENT_TOKEN_TTL_SECONDS=2592000

# Any LiteLLM-supported provider can be configured here. For an OpenAI-compatible
# domestic provider, keep the openai/ prefix and set its API base URL.
LLM_MODEL=openai/your-provider-model-id
LLM_API_BASE=https://provider.example.com/v1
LLM_API_KEY=replace-with-provider-api-key

# Use json_schema when the provider supports strict JSON Schema output.
# Change to json_object for providers that only implement JSON mode; local schema
# validation in the post-processing layer remains enabled in either mode.
STRUCTURED_OUTPUT_MODE=json_schema
