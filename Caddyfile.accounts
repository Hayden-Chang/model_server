{
	default_sni {$PUBLIC_DOMAIN}
}

https://{$PUBLIC_DOMAIN} {
	tls /etc/letsencrypt/live/{$PUBLIC_DOMAIN}/fullchain.pem /etc/letsencrypt/live/{$PUBLIC_DOMAIN}/privkey.pem
	encode zstd gzip
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}
	@private path /internal /internal/*
	handle @private {
		respond 404
	}
	@account path /api/* /billing/* /webhooks/apple /admin/time-fragment/*
	handle @account {
		reverse_proxy time-fragment-api:8000 {
			transport http {
				dial_timeout 5s
				response_header_timeout 120s
			}
		}
	}
	handle {
		reverse_proxy business-api:8000 {
			transport http {
				dial_timeout 5s
				response_header_timeout 120s
			}
		}
	}
}

# TestFlight purchases are signed in Apple's sandbox environment. Keep this
# hostname on a sandbox-only API even after the public service switches to
# APPLE_ENVIRONMENT=production.
https://staging.api.keeline.xyz {
	tls /etc/letsencrypt/live/staging.api.keeline.xyz/fullchain.pem /etc/letsencrypt/live/staging.api.keeline.xyz/privkey.pem
	encode zstd gzip
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-Apple-Billing-Environment sandbox
	}
	@private path /internal /internal/*
	handle @private {
		respond 404
	}
	@testflight path /api/* /billing/* /webhooks/apple /health/*
	handle @testflight {
		reverse_proxy testflight-api:8000 {
			transport http {
				dial_timeout 5s
				response_header_timeout 120s
			}
		}
	}
	handle {
		respond 404
	}
}
